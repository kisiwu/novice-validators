{
  "name": "novice-validators",
  "version": "1.0.0",
  "description": "Request validators for @novice1/routing.",
  "homepage": "https://github.com/kisiwu/novice-validators",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kisiwu/novice-validators.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "clean": "pnpm -r exec rimraf node_modules lib docs coverage && rimraf node_modules",
    "clean:build": "pnpm -r exec rimraf lib",
    "clean:deps": "pnpm -r exec rimraf node_modules && rimraf node_modules",
    "clean:coverage": "pnpm -r exec rimraf coverage",
    "doc": "pnpm --filter \"./packages/*\" -r doc",
    "format": "pnpm --filter \"./packages/*\" -r format",
    "format:check": "pnpm --filter \"./packages/*\" -r format:check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test",
    "release:build": "pnpm --filter \"./packages/*\" -r build",
    "release:test": "pnpm --filter \"./packages/*\" -r test",
    "release:version": "pnpm --filter \"./packages/*\" -r exec npm version",
    "release:publish": "pnpm --filter \"./packages/*\" -r publish --access public",
    "version:patch": "pnpm --filter \"./packages/*\" -r exec npm version patch",
    "version:minor": "pnpm --filter \"./packages/*\" -r exec npm version minor",
    "version:major": "pnpm --filter \"./packages/*\" -r exec npm version major"
  },
  "keywords": [
    "validators",
    "routing",
    "novice1"
  ],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "devDependencies": {
    "@novice1/routing": "^2.2.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "kaukau": "^6.0.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "supertest": "^7.3.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2"
  }
}